           <property name="styleSheet">
            <string notr="true">/* Estilo para la ventana principal (el fondo) */
#ventanaPrincipal {
    background-image: url(menu.jpg); /* Asegúrate que menu.jpg esté accesible */
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
}

/* Estilo para TODOS los QPushButton */
QPushButton {
    /* Tamaño específico */
    width: 100px; /* Ancho del botón */
    height: 54px; /* Altura del botón */

    font-size: 18px;
    font-weight: bold;
    color: #FFFFFF; /* Texto blanco */
    background-color: rgba(30, 0, 70, 0.8); /* Fondo oscuro más intenso y opaco */
    border: 3px solid #FF00FF; /* Borde neón más grueso y vibrante (fuchsia) */
    border-radius: 15px; /* Bordes redondeados */
    padding: 0px; /* Quitamos el padding para que width/height controlen el tamaño total */
    
}

/* Efecto al pasar el mouse por encima */
QPushButton:hover {
    background-color: rgba(255, 0, 255, 0.8); /* Se ilumina con el color fuchsia neón, más opaco */
    border: 3px solid #FFFFFF; /* Borde cambia a blanco */

}

/* Efecto al presionar el botón */
QPushButton:pressed {
    background-color: rgba(255, 0, 255, 1); /* Completamente opaco y brillante */
    border: 3px solid #DDDDDD;

}</string>
