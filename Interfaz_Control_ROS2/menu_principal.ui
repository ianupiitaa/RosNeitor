           <property name="styleSheet">
            <string notr="true">/* Estilo para el QSlider (horizontal) */

QSlider::groove:horizontal {
    background-color: rgba(30, 30, 30, 0.7); /* Fondo oscuro como los botones */
    border: 1px solid #505050; /* Borde oscuro */
    height: 8px; /* Altura del canal */
    border-radius: 4px;
    

}

/* Estilo para la parte &quot;rellena&quot; del slider (lo que ya pasó) */
QSlider::sub-page:horizontal {
    background-color: #AAAAAA; /* Gris claro sólido para el progreso */
    border: 1px solid #505050;
    height: 8px;
    border-radius: 4px;
}

/* Estilo para el &quot;mango&quot; o &quot;perilla&quot; que se arrastra */
QSlider::handle:horizontal {
    background-color: #E0E0E0; /* Color principal (como el texto del label) */
    border: 1px solid #707070; /* Borde gris medio */
    width: 18px; /* Ancho del mango */
    height: 18px; /* Alto del mango */
    border-radius: 9px; /* Esto lo hace un círculo perfecto */
    
    /* Margen negativo para que el mango se superponga al canal */
    /* (Alto del mango - Alto del canal) / 2 = (18 - 8) / 2 = 5 */
    margin: -5px 0; 
}

/* Efecto al pasar el mouse por encima del mango */
QSlider::handle:horizontal:hover {
    background-color: #FFFFFF; /* Blanco puro */
    border: 1px solid #AAAAAA; /* Borde más claro */

}

/* Efecto al presionar el mango */
QSlider::handle:horizontal:pressed {
    background-color: #D0D0D0; /* Un gris un poco más oscuro */
    border: 1px solid #505050;

}</string>
           </property>
           <property name="orientation">
            <enum>Qt::Orientation::Horizontal</enum>
           </property>
