          <property name="styleSheet">
           <string notr="true">/* Estilo para la ventana principal (el fondo) */
#ventanaPrincipal {
    background-image: url(tu_imagen_fondo_negro.jpg); /* Asegúrate de usar la nueva imagen de fondo */
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
}

/* Estilo para TODOS los QPushButton */
QPushButton {
    width: 100px;
    height: 54px;
    font-size: 16px; /* Un poco más pequeño para un look más serio */
    font-weight: bold;
    color: #E0E0E0; /* Texto blanco grisáceo para un look sutil */
    background-color: rgba(30, 30, 30, 0.7); /* Fondo gris oscuro semi-transparente */
    border: 1px solid #707070; /* Borde gris sutil */
    border-radius: 5px; /* Bordes ligeramente redondeados, más cuadrados */
    padding: 0px;
    
 
}

/* Efecto al pasar el mouse por encima */
QPushButton:hover {
    color: #FFFFFF; /* Texto blanco puro */
    background-color: rgba(50, 50, 50, 0.8); /* Fondo un poco más claro y opaco */
    border: 1px solid #AAAAAA; /* Borde más claro */

}

/* Efecto al presionar el botón */
QPushButton:pressed {
    color: #DDDDDD;
    background-color: rgba(20, 20, 20, 0.9); /* Más oscuro y opaco para simular &quot;hundimiento&quot; */
    border: 1px solid #505050;

}</string>
